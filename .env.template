# -------------------
# CLOUDFLARE TURNSTILE
# Bot protection on the public forms (newsletter, side panel, contact sidebar).
# Create the widget at https://dash.cloudflare.com → Turnstile.
# The site key is public and ships to the browser; the secret key must never be committed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Hostnames allowed to solve a challenge, comma separated. Siteverify reports which
# hostname actually solved it, so checking it here stops a token minted elsewhere
# being replayed against this backend - defence in depth beyond Cloudflare's own
# widget hostname restriction.
# Leave empty to skip the check: local development has no list, and a missing value
# must not take the forms down. Production should set it.
TURNSTILE_HOSTNAMES="bradylegler.com,www.bradylegler.com,staging.bradylegler.com"

# Enforcement switch. Defaults to enabled when unset, so a missing value fails safe
# towards protection.
#
#   "true"   verify every submission and REJECT the ones that fail
#   "false"  MONITOR MODE - still verify every submission and still log the outcome,
#            but never reject. Cloudflare's analytics fill in with real siteverify
#            data, so you can see the valid/invalid token split on live traffic
#            before you start turning anyone away.
#
# Changing it takes effect without a redeploy, so it doubles as a kill switch if
# enforcement ever starts blocking genuine customers.
TURNSTILE_ENFORCE="true"

# Local development uses Cloudflare's published test keys rather than adding localhost
# to the widget:
#   site   always passes  1x00000000000000000000AA
#   site   always fails   2x00000000000000000000AB
#   secret always passes  1x0000000000000000000000000000000AA
#   secret duplicate err  3x0000000000000000000000000000000AA
